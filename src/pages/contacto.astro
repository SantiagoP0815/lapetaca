---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/paths';
import { BUSINESS, locationLabel, whatsappUrl, instagramUrl } from '../data/business';
---

<BaseLayout
  title={`Contacto | ${BUSINESS.name}`}
  description={`Contacta a ${BUSINESS.name} en ${locationLabel}. Teléfono y WhatsApp disponibles.`}
>
  <PageHero
    eyebrow="Estamos para escucharte"
    title="Planifiquemos"
    accent="tu visita."
    description="Encuentra aquí los canales oficiales de La Petaca."
    short
  />

  <section class="section contact-section contact-page-section" aria-labelledby="contact-details-title">
    <div class="contact-watermark" aria-hidden="true">
      <img src={withBase('/assets/branding/logo-emblem-white.svg')} alt="" />
    </div>
    <div class="container contact-grid">
      <div class="contact-copy" data-reveal>
        <img class="contact-logo" src={withBase('/assets/branding/logo-horizontal-white.svg')} alt={BUSINESS.name} />
        <h2 id="contact-details-title">Hablemos<br />directamente</h2>
        <p>
          Estamos ubicados en {locationLabel}. Abrimos los sábados y domingos,
          y entre semana atendemos con reserva.
        </p>
        <p class="provisional-note provisional-note-light">Dirección exacta y horario de apertura por confirmar</p>
      </div>

      <div class="contact-details" data-reveal style="--reveal-delay: 120ms">
        <div class="contact-detail">
          <span class="detail-label"><Icon name="pin" size={14} /> Ubicación</span>
          <strong><a href={BUSINESS.googleMapsUrl} target="_blank" rel="noopener noreferrer">Ver en Google Maps</a></strong>
          <span class="detail-muted">{BUSINESS.city}, {BUSINESS.department} · {BUSINESS.country}</span>
        </div>
        <div class="contact-detail">
          <span class="detail-label"><Icon name="phone" size={14} /> Teléfono</span>
          <strong><a href={`tel:+${BUSINESS.countryCode}${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a></strong>
          <span class="detail-muted">También disponible por WhatsApp</span>
        </div>
        <div class="contact-detail">
          <span class="detail-label"><Icon name="sun" size={14} /> Horarios</span>
          <strong>{BUSINESS.openingHours[0]}</strong>
          <span class="detail-muted">{BUSINESS.openingHours[1]}</span>
        </div>
        <div class="contact-detail">
          <span class="detail-label"><Icon name="instagram" size={14} /> Redes sociales</span>
          <strong><a href={instagramUrl} target="_blank" rel="noopener noreferrer">@{BUSINESS.instagram}</a></strong>
          <span class="detail-muted">Síguenos en Instagram</span>
        </div>
        <a class="button button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Escribir por WhatsApp <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
