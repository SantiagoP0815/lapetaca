---
import BaseLayout from '../layouts/BaseLayout.astro';
import WelcomeVideo from '../components/WelcomeVideo.astro';
import Icon from '../components/Icon.astro';
import QrCode from '../components/QrCode.astro';
import { withBase } from '../lib/paths';
import { BUSINESS, locationLabel, whatsappUrl } from '../data/business';
import { MENU_DAY, formatPrice } from '../data/menu';

// TODO(cliente): reemplazar textos y tarjetas con contenido oficial confirmado.
const experienceCards = [
  {
    number: '01',
    title: 'El lugar',
    text: 'Conoce la identidad y los espacios de La Petaca.',
    art: '',
    href: withBase('/galeria/')
  },
  {
    number: '02',
    title: 'La mesa',
    text: 'Descubre nuestra propuesta gastronómica.',
    art: 'art-table',
    href: withBase('/menu/')
  },
  {
    number: '03',
    title: 'Los encuentros',
    text: 'Próximamente: eventos y experiencias confirmadas.',
    art: 'art-gathering',
    href: withBase('/contacto/')
  }
];

// TODO(cliente): reemplazar por fotografías oficiales del establecimiento.
const galleryPlaceholders = [1, 2, 3, 4];

// Vista previa de la carta oficial: primeros platos del menú del día.
const menuPreviewRows = MENU_DAY.slice(0, 4);
---

<BaseLayout
  title={`${BUSINESS.name} | ${BUSINESS.city}, ${BUSINESS.department}`}
  description="Conoce La Petaca Club Campestre en Páramo, Santander. Información, gastronomía, espacios y formas de contacto."
>
  <!-- Hero: lienzo negro-oliva, display limón y fotografía editorial -->
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="hero-watermark" aria-hidden="true">
      <img src={withBase('/assets/branding/logo-emblem-white.svg')} alt="" />
    </div>
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow eyebrow-light" data-hero-reveal style="--hero-delay: 0ms">{locationLabel}</p>
        <h1 class="sr-only" id="hero-title">{BUSINESS.name}</h1>
        <img class="hero-logo" src={withBase('/assets/branding/logo-horizontal-white.svg')} alt="La Petaca" data-hero-reveal style="--hero-delay: 100ms" />
        <p class="hero-accent" data-hero-reveal style="--hero-delay: 200ms">Club Campestre</p>
        <p class="hero-lead" data-hero-reveal style="--hero-delay: 300ms">
          Restaurante campestre
          <span class="hero-lead-accent">con menú de día y de noche.</span>
        </p>
        <div class="action-row" data-hero-reveal style="--hero-delay: 400ms">
          <a class="button button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            Contáctanos <Icon name="arrow-right" />
          </a>
          <a class="text-link text-link-light" href={withBase('/menu/')}>Ver menú <Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="hero-photo" data-hero-reveal style="--hero-delay: 350ms" aria-hidden="true">
        <span class="symbol-mark hero-photo-mark"></span>
        <p>Fotografía oficial<br />próximamente</p>
      </div>
    </div>
  </section>

  <!-- Cinta de datos: identidad, propuesta y contacto en movimiento -->
  <section class="ticker" aria-label="Datos de La Petaca">
    <div class="ticker-track">
      {[0, 1].map((group) => (
        <div class="ticker-group" aria-hidden={group === 1 || undefined}>
          <p class="ticker-item">{locationLabel}<span class="symbol-mark" aria-hidden="true"></span></p>
          <p class="ticker-item">{BUSINESS.type}<span class="symbol-mark" aria-hidden="true"></span></p>
          <p class="ticker-item">Menú de día<span class="symbol-mark" aria-hidden="true"></span></p>
          <p class="ticker-item">Menú noche<span class="symbol-mark" aria-hidden="true"></span></p>
          <p class="ticker-item">{BUSINESS.phoneDisplay}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Bienvenida: panel crema, video pendiente -->
  <section class="section section--cream" aria-labelledby="welcome-title">
    <div class="container welcome-grid">
      <div data-reveal>
        <WelcomeVideo />
      </div>
      <div class="section-heading" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">Una primera mirada</p>
        <h2 id="welcome-title">En movimiento</h2>
        <img class="gallery-logo" src={withBase('/assets/branding/logoarriba+lapetaca.svg')} alt="La Petaca" />
        <p class="section-intro section-intro-left">
          El video oficial de bienvenida se incorporará aquí para presentar el lugar desde una mirada auténtica.
        </p>
        <p class="provisional-note">Video pendiente de entrega por parte del cliente</p>
      </div>
    </div>
  </section>

  <!-- Experiencia: tarjetas de fotografía sin cromo -->
  <section class="section section--cream hairline-top" id="experiencia" aria-labelledby="experience-title">
    <div class="container">
      <div class="section-heading centered-heading" data-reveal>
        <p class="eyebrow">La experiencia</p>
        <h2 id="experience-title">Un espacio para<br />vivir el momento</h2>
        <p class="section-intro">Conoce próximamente los espacios, servicios y actividades disponibles en La Petaca.</p>
      </div>

      <div class="card-grid">
        {experienceCards.map((card, index) => (
          <article class="feature-card" data-reveal style={`--reveal-delay: ${(index + 1) * 80}ms`}>
            <div class:list={['card-art', card.art]} aria-hidden="true">
              <span class="symbol-mark card-mark"></span>
              <span class="card-label">Fotografía oficial<br />próximamente</span>
            </div>
            <div class="feature-card-content">
              <span class="card-number">{card.number}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <a class="text-link" href={card.href}>Conocer más <Icon name="arrow-right" /></a>
              <span class="provisional-tag">Información por confirmar</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Gastronomía: lienzo oscuro + panel de carta crema -->
  <section class="section food-section" id="gastronomia" aria-labelledby="food-title">
    <div class="container food-grid">
      <div class="food-copy" data-reveal>
        <p class="eyebrow eyebrow-light">De nuestra mesa</p>
        <h2 id="food-title">Gastronomía<br />con identidad</h2>
        <p class="lead-copy">
          Elige entre el menú del día y el menú noche, y descubre los platos de La Petaca.
        </p>
        <div class="action-row">
          <a class="button button-primary" href={withBase('/menu/')}>Ver la carta <Icon name="arrow-right" /></a>
          <a class="text-link text-link-light" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            Pedir por WhatsApp <Icon name="arrow-right" />
          </a>
        </div>
      </div>

      <div class="menu-card" data-reveal style="--reveal-delay: 120ms">
        <p class="menu-card-header">
          <span class="menu-card-brand">
            <img class="menu-card-logo" src={withBase('/assets/branding/logo-horizontal-green.svg')} alt="La Petaca" />
          </span>
          <span>Menú del día</span>
        </p>
        <p class="menu-card-title">La carta</p>
        <ul class="menu-list">
          {menuPreviewRows.map((row) => (
            <li class="menu-row">
              <span class="menu-name">{row.name}</span>
              <span class="menu-dots" aria-hidden="true"></span>
              <span class="menu-price">{formatPrice(row.price)}</span>
            </li>
          ))}
        </ul>
        <p class="menu-card-note">Vista parcial · Elige entre el menú del día y el menú noche</p>

        <div class="menu-card-qr">
          <QrCode size={360} />
          <p class="qr-caption">Escanea y mira la carta completa</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Galería: teselas de borde a borde -->
  <section class="section section--cream" id="galeria" aria-labelledby="gallery-title">
    <div class="container">
      <div class="gallery-heading">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Una mirada al lugar</p>
          <h2 id="gallery-title">Galería</h2>
          <img class="gallery-logo" src={withBase('/assets/branding/lapetacaclubcampestre+logo.svg')} alt="La Petaca Club Campestre" />
        </div>
        <p class="section-intro" data-reveal style="--reveal-delay: 100ms">
          Reemplazaremos estos espacios por fotografías oficiales del establecimiento.
        </p>
      </div>

      <div class="gallery-grid">
        {galleryPlaceholders.map((item, index) => (
          <div
            class:list={['gallery-item', { 'gallery-wide': index === 0, 'gallery-tall': index === 3 }]}
            data-reveal
            style={`--reveal-delay: ${(index + 1) * 60}ms`}
          >
            <div class:list={['gallery-placeholder', `placeholder-${item}`]}>
              <span class="symbol-mark gallery-mark" aria-hidden="true"></span>
              <span class="gallery-label">Imagen oficial<br />próximamente</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto: cierre del recorrido -->
  <section class="section contact-section" aria-labelledby="contact-strip-title">
    <div class="container contact-grid">
      <div class="contact-copy" data-reveal>
        <p class="eyebrow eyebrow-light">Contáctanos</p>
        <h2 id="contact-strip-title">Planifica tu visita</h2>
        <p>Confirma tu visita por teléfono o por WhatsApp.</p>
      </div>

      <div class="contact-details" data-reveal style="--reveal-delay: 100ms">
        <div class="contact-detail">
          <span class="detail-label"><Icon name="pin" size={14} /> Ubicación</span>
          <strong><a href={BUSINESS.googleMapsUrl} target="_blank" rel="noopener noreferrer">Ver en Google Maps</a></strong>
          <span class="detail-muted">{locationLabel}</span>
        </div>
        <div class="contact-detail">
          <span class="detail-label"><Icon name="phone" size={14} /> Teléfono</span>
          <strong><a href={`tel:+${BUSINESS.countryCode}${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a></strong>
          <span class="detail-muted">También disponible por WhatsApp</span>
        </div>
        <div class="contact-detail">
          <span class="detail-label"><Icon name="sun" size={14} /> Horarios</span>
          <strong>{BUSINESS.openingHours[0]}</strong>
          <span class="detail-muted">{BUSINESS.openingHours[1]}</span>
        </div>
        <a class="button button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Escribir por WhatsApp <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
