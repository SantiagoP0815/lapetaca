---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuSection from '../components/MenuSection.astro';
import PageHero from '../components/PageHero.astro';
import { BUSINESS, locationLabel } from '../data/business';
---

<BaseLayout
  title={`Menú | ${BUSINESS.name}`}
  description={`Menú del día y menú noche de ${BUSINESS.name} en ${locationLabel}. Escanea el código QR y elige tu menú.`}
>
  <PageHero
    eyebrow="De nuestra mesa"
    title="El menú"
    accent="La Petaca."
    description="Elige entre el menú del día y el menú noche."
    accentLogo
  />

  <MenuSection />
</BaseLayout>
