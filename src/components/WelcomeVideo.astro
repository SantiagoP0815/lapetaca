---
interface Props { hasVideo?: boolean; }
const { hasVideo = false } = Astro.props;
---

<div class="welcome-video" aria-label="Video de bienvenida de La Petaca">
  {hasVideo ? (
    <video class="welcome-video-player" controls muted loop playsinline preload="metadata" poster="/assets/video/welcome-poster.svg">
      <source src="/assets/video/welcome.webm" type="video/webm" />
      <source src="/assets/video/welcome.mp4" type="video/mp4" />
      Tu navegador no puede reproducir este video.
    </video>
  ) : (
    <div class="video-placeholder" role="img" aria-label="Video de bienvenida pendiente de confirmación">
      <span class="video-play" aria-hidden="true">▶</span>
      <span>Video de bienvenida<br /><em>próximamente</em></span>
      <small>Reemplazar por material audiovisual oficial</small>
    </div>
  )}
</div>
