---
import { BUSINESS } from '../data/business';

const navigation = [
  { label: 'Inicio', href: '/' },
  { label: 'Menú', href: '/menu/' },
  { label: 'Galería', href: '/galeria/' },
  { label: 'Contacto', href: '/contacto/' }
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${BUSINESS.name}, inicio`}>
      <img class="brand-logo" src="/assets/branding/logo-light.svg" alt={BUSINESS.name} />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Abrir menú</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Navegación principal">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="nav-cta" href={`https://wa.me/${BUSINESS.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
