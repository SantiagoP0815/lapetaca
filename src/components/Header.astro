---
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
import { BUSINESS, MENU_PATH, whatsappUrl } from '../data/business';

const navigation = [
  { label: 'Inicio', href: withBase('/') },
  { label: 'Menú', href: withBase(MENU_PATH) },
  { label: 'Galería', href: withBase('/galeria/') },
  { label: 'Contacto', href: withBase('/contacto/') }
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === withBase('/') ? currentPath === withBase('/') : currentPath.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${BUSINESS.name}, inicio`}>
      <img class="brand-logo" src={withBase('/assets/branding/logo-horizontal-white.svg')} alt={BUSINESS.name} />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Abrir menú</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Navegación principal">
      <ul class="nav-group">
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <ul class="nav-group nav-group-right">
        <li>
          <a class="nav-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            WhatsApp <Icon name="whatsapp" size={16} />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
