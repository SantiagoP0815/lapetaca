---
import { withBase } from '../lib/paths';

interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  description: string;
  note?: string;
  short?: boolean;
  // Sustituye el texto del acento por el logo oficial (para no escribir "La Petaca")
  accentLogo?: boolean;
}

const { eyebrow, title, accent, description, note, short = false, accentLogo = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero-short': short }]} aria-labelledby="page-hero-title">
  <div class="page-hero-watermark" aria-hidden="true">
    <img src={withBase('/assets/branding/logo-emblem-white.svg')} alt="" />
  </div>
  <div class="container page-hero-content">
    <p class="eyebrow eyebrow-light">{eyebrow}</p>
    <h1 id="page-hero-title">{title}{!accentLogo && <span class="accent">{accent}</span>}</h1>
    {accentLogo && <img class="page-hero-logo" src={withBase('/assets/branding/logo-horizontal-white.svg')} alt="La Petaca" />}
    <p class="page-hero-sub">{description}</p>
    {note && <p class="provisional-note provisional-note-light">{note}</p>}
  </div>
</section>
