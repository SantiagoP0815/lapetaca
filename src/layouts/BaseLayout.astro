---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#183f35" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/assets/branding/symbol-primary.svg" type="image/svg+xml" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />

    <script>
      const root = document.documentElement;
      root.classList.add('js', 'motion-demo');

      document.addEventListener('astro:before-preparation', (event) => {
        const originalLoader = event.loader;
        event.loader = async () => {
          root.classList.add('page-leaving');
          await Promise.all([
            originalLoader(),
            new Promise((resolve) => window.setTimeout(resolve, 650))
          ]);
        };
      });

      const initializePage = () => {
        const menuToggle = document.querySelector('.menu-toggle');
        const siteNav = document.querySelector('.site-nav');
        const siteHeader = document.querySelector('[data-header]');
        const motionDisabled = new URLSearchParams(window.location.search).get('motion') === 'off';

        if (siteNav && menuToggle) {
          menuToggle.addEventListener('click', () => {
            const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
            menuToggle.setAttribute('aria-expanded', String(!isOpen));
            siteNav.classList.toggle('is-open', !isOpen);
          });
          siteNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
            menuToggle.setAttribute('aria-expanded', 'false');
            siteNav.classList.remove('is-open');
          }));
        }

        if (siteHeader) {
          const updateHeader = () => siteHeader.classList.toggle('is-scrolled', window.scrollY > 24);
          updateHeader();
          window.addEventListener('scroll', updateHeader, { passive: true });
        }

        document.querySelectorAll('.feature-card-hitbox').forEach((hitbox) => {
          if (hitbox.dataset.hoverBound) return;
          hitbox.dataset.hoverBound = 'true';
          hitbox.addEventListener('mouseenter', () => hitbox.classList.add('is-hovered'));
          hitbox.addEventListener('mouseleave', () => hitbox.classList.remove('is-hovered'));
        });

        if (motionDisabled) {
          root.classList.remove('motion-demo');
          document.querySelectorAll('[data-reveal]').forEach((item) => item.classList.add('is-visible'));
          return;
        }

        root.classList.add('motion-demo');
        const revealItems = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries, currentObserver) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              currentObserver.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px' });
          revealItems.forEach((item) => observer.observe(item));
        } else revealItems.forEach((item) => item.classList.add('is-visible'));

        const parallaxItems = document.querySelectorAll('[data-parallax]');
        const hero = document.querySelector('.hero');
        let parallaxFrame = null;
        const requestFrame = window.requestAnimationFrame || ((callback) => window.setTimeout(callback, 16));
        const updateParallax = () => {
          parallaxFrame = null;
          if (!hero || window.scrollY > hero.offsetHeight) return;
          const distance = Math.min(window.scrollY, hero.offsetHeight);
          parallaxItems.forEach((item) => item.style.setProperty('--parallax-y', `${distance * (Number(item.dataset.parallax) || 0)}px`));
        };
        window.addEventListener('scroll', () => {
          if (parallaxFrame === null) parallaxFrame = requestFrame(updateParallax);
        }, { passive: true });
        updateParallax();
      };

      initializePage();
      document.addEventListener('astro:page-load', initializePage);
      document.addEventListener('astro:after-swap', () => {
        root.classList.remove('page-leaving');
        root.classList.add('page-entering');
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        window.setTimeout(() => root.classList.remove('page-entering'), 750);
      });
    </script>
  </body>
</html>
